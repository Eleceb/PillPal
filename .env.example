# Copy this file to .env and fill in your own values.
# Expo loads .env automatically; EXPO_PUBLIC_* variables are inlined into the
# app bundle at build time, so treat them as public identifiers, not secrets,
# and restrict the Google Maps key in the Google Cloud console.
# For cloud EAS builds, set these as EAS environment variables instead
# (.env is gitignored and not uploaded).

# Firebase project settings: Firebase console > Project settings > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps / Places API key (used by the pharmacy map)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
